*.js
!jest.config.js
!init-db.js
!test-client.js
!cache_debug.js
!insert-map.js
!deploy.js
*.d.ts
node_modules

# CDK asset staging directory
.cdk.staging
cdk.out*
# Local Lambda layer build output (generated by cdk synth/deploy)
.layer-build/
.vscode/

# Deployment configuration (contains account IDs — do not commit)
deploy.config.yaml

# Admin console frontend (Vite/Vue). The blanket *.js rule above is aimed at
# compiled output beside the CDK sources; the frontend keeps its JS config files
# in source control, so re-include them here.
!admin-console/**/*.js
!admin-console/**/*.d.ts
admin-console/dist/
admin-console/.env
admin-console/.env.local
# Quasar CLI build artefacts and generated types.
admin-console/.quasar/
admin-console/node_modules/
# The Element Plus console, kept for reference during the Quasar migration.
admin-console-old/dist/
admin-console-old/.env
admin-console-old/.env.local
admin-console-old/node_modules/

# Python bytecode. These sit inside the Lambda function directories, which are
# packaged with Code.fromAsset, so leaving them around changes the asset hash
# and ships compiled junk in the deployment bundle.
__pycache__/
*.pyc
