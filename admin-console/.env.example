# Admin console environment.
#
# You do not normally create this file. `npm run deploy` (from the repository
# root) writes admin-console/.env from the stack's own CloudFormation outputs
# on every deploy, and overwrites whatever is there — so a hand-edited copy
# lasts until the next deploy and no longer.
#
# Copy this file only to run the console locally with `quasar dev` against a
# deployment you are not deploying to yourself. Fill the four values in from
# the stack outputs:
#
#   aws cloudformation describe-stacks --stack-name MsightCloudStack \
#     --query "Stacks[0].Outputs[?OutputKey=='AdminApiUrl'||OutputKey=='AdminUserPoolId'||OutputKey=='AdminUserPoolClientId'].[OutputKey,OutputValue]" \
#     --output text
#
# All four are required: src/config.ts refuses to start without them rather
# than falling back to a default, because a console pointed at the wrong
# account is worse than one that will not load.

# The region the stack is deployed in. Also what the console's AWS deep links
# are built against, so a wrong value produces links to an empty console.
VITE_AWS_REGION=us-east-2

# Cognito, from the AdminUserPoolId and AdminUserPoolClientId outputs.
VITE_USER_POOL_ID=us-east-2_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# The admin API, from the AdminApiUrl output. No trailing slash — one is
# stripped anyway, but the value is easier to compare against the output
# without it.
VITE_ADMIN_API_URL=https://xxxxxxxxxx.execute-api.us-east-2.amazonaws.com
