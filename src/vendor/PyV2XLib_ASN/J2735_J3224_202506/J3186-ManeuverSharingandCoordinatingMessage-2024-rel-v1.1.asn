--
-- Use of this module defined in SAE J3186
-- Latest document release for this module is Mar 2023
-- Filename: J3186-ManeuverSharingandCoordinatingMessage-2024-rel-v1.1.asn 
--

ManeuverSharingAndCoordinatingMessage
{joint-iso-itu-t (2) country (16) us (840) organization (1) sae (114566) 
v2x-communications (1) technical-committees (1) v2x-vehicular-applications (8) 
technical-reports (1) j3186 (3186) asn1-module (1) maneuverSharingAndCoordinatingMessage (42) 
version-1 (1) version-minor-1 (1)}

DEFINITIONS AUTOMATIC TAGS ::=
BEGIN

IMPORTS
    AccelerationSet4Way,
    DDateTime,
    Heading,
    Position3D,
    PositionalAccuracy,
    PositionConfidenceSet,
    Speed,
    TemporaryID,
    VehicleSize
        FROM Common {joint-iso-itu-t (2) country (16) us (840) organization (1) sae (114566) 
		v2x-communications (1) technical-committees (1) v2x-core (5) technical-reports (1) 
		j2735 (2735) part-0 (0) asn1-module (1) common (38) 
		version-1 (1)  version-minor-1 (1)} WITH SUCCESSORS;

ManeuverSharingAndCoordinatingMessage ::= SEQUENCE {
    mSCMTimestamp               DDateTime,
    hVPos                       Position3D             OPTIONAL,
    hVPosXYConf                 PositionalAccuracy     OPTIONAL,
    -- HV’s reference position and accuracy
    -- Required for mSCMType = 0, 1, 3, and 6
    -- Not allowed otherwise
    mSCMType                    MSCMType,
    sourceID                    TemporaryID,
    destinationIDs              TemporaryIDList        OPTIONAL,
    -- RVs’ IDs
    -- Required for mSCMType = 1, 2, 3, 4, 5, 6 and 7
    -- Allowed for mSCMType = 0
    maneuverID                  ManeuverID             OPTIONAL,
    -- MSCS session ID by being combined with HV’s ID
    -- Required for mSCMType = 1, 2, 3, 4, 5, 6 and 7
    -- Not allowed for mSCMType = 0
    maneuver                    Maneuver               OPTIONAL,
    -- Required for mSCMType = 0, 1 and 6
    -- Allowed for mSCMType = 2 in order to propose adjustments
    -- Not allowed for mSCMType = 3, 4, 5 and 7
    responseFlag                ResponseFlag           OPTIONAL,
    -- Indication of acceptance or rejection
    -- Required for mSCMType = 2
    -- Not allowed otherwise
    reasonCode                 ReasonCode              OPTIONAL,
    -- Allowed for mSCMType = 2, 4 and 5
    -- Not allowed otherwise
    maneuverExecutionStatus    ManeuverExecutionStatus OPTIONAL,
    -- Required for mSCMType = 7
    -- Not allowed otherwise
    ...
}

MSCMType ::= ENUMERATED {
    maneuverIntent                (0),
    maneuverRequest               (1),
    maneuverResponse              (2),
    maneuverReservation           (3),
    hVManeuverCancellation        (4),
    rVManeuverCancellationRequest (5),
    emergencyManeuverReservation  (6),
    maneuverExecutionStatus       (7),
    ...
}

TemporaryIDList ::= SEQUENCE (SIZE(1..32)) OF TemporaryID

ManeuverID ::= INTEGER (0..255)

Maneuver ::= SEQUENCE {
    subManeuverList SubManeuverList,
    ...
}

SubManeuverList ::= SEQUENCE (SIZE(1..32)) OF SubManeuver

SubManeuver ::= SEQUENCE {
    executantVehID      TemporaryID,
    affectedVehIDs      TemporaryIDPointer,
    currentStateData    CurrentStateData,
    targetRoadResource  TargetRoadResource OPTIONAL,
    startTime           DDateTime,                   -- Temporal characteristics
    endTime             DDateTime,
    minSpeed            Speed              OPTIONAL, -- Kinematic characteristics
    maxSpeed            Speed              OPTIONAL,
    ...
}

TemporaryIDPointer ::= BIT STRING (SIZE(1..32))
-- The size shall be identical to the size of destinationIDs.

CurrentStateData ::= SEQUENCE {
    executantVehPos           PositionOffsetXYZ     OPTIONAL,
    executantVehPosConfidence PositionConfidenceSet OPTIONAL,
    speed                     Speed,
    heading                   Heading,
    accel4way                 AccelerationSet4Way   OPTIONAL,
    size                      VehicleSize,
    ...
}

PositionOffsetXYZ ::= SEQUENCE {
    offsetX     ObjectDistance,
    offsetY     ObjectDistance,
    offsetZ     ObjectDistance OPTIONAL
}

ObjectDistance ::= INTEGER(-32767..32767) -- LSB units of 0.1 meters

TargetRoadResource ::= SEQUENCE {
    tRRType         TRRType,
    tRRLocation     TRRLocation,
    ...
}

TRRType ::= ENUMERATED {
    tRRType1 (0),
    tRRType2 (1),
    tRRType3 (2),
    ...
}

TRRLocation ::= CHOICE {
    tRRLocationType1 TRRLocationType1,
    -- This shall be chosen when tRRType = 0 (tRRType1)
    tRRLocationType2 TRRLocationType2,
    -- This shall be chosen when tRRType = 1 (tRRType2)
    tRRLocationType3 TRRLocationType3,
    -- This shall be chosen when tRRType = 2 (tRRType3)
    ...
}

TRRLocationType1 ::= SEQUENCE {
    tRRLength         TRRLength,
    frontSidePosition PositionOffsetXYZ,
    laneOffset        LaneOffset,
    tRRMovement       Speed OPTIONAL,
    ...
}

TRRLocationType2 ::= SEQUENCE {
    safetyGap        TRRLength,
    frontSideVehicle SurroundingVehicleInfo OPTIONAL,
    rearSideVehicle  SurroundingVehicleInfo OPTIONAL,
    tRRLength        TRRLength              OPTIONAL,
    laneOffset       LaneOffset,
    ...
}

TRRLocationType3 ::= SEQUENCE OF PositionOffsetXYZ

TRRLength ::= INTEGER (0..4095)  -- LSB units are 0.1 meters

LaneOffset ::= ENUMERATED {
    currentLane     (0),
    firstLeftLane   (1),
    firstRightLane  (2),
    secondLeftLane  (3),
    secondRightLane (4),
    thirdLeftLane   (5),
    thirdRightLane  (6),
    ...
}

SurroundingVehicleInfo ::= SEQUENCE {
    surroundingVehicleID       TemporaryID,
    surroundingVehiclePosition PositionOffsetXYZ,
    surroundingVehicleSize     VehicleSize,
    ...
}

ResponseFlag ::= BOOLEAN

ReasonCode ::= ENUMERATED {
    unknown                             (0),
    unableToConform                     (1),
    unwanted                            (2),
    unableToUnderstand                  (3),
    erroneousBehaviorDetected           (4),
    misbehaviorAttackDetected           (5),
    rVManeuverCancellationRequestIssued (6),
    sessionIDConflicted                 (7),
    ...
}

ManeuverExecutionStatus ::= ENUMERATED {
    started         (0),
    inProgress      (1),
    completed       (2),        -- successfully finished
    terminated      (3),        -- unsuccessfully finished
    ...
}

END

