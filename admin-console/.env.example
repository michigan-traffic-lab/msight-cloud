# Copy to .env and fill in from the `cdk deploy` outputs.
#
#   AdminUserPoolId       -> VITE_USER_POOL_ID
#   AdminUserPoolClientId -> VITE_USER_POOL_CLIENT_ID
#   AdminApiUrl           -> VITE_ADMIN_API_URL

VITE_AWS_REGION=us-east-2
VITE_USER_POOL_ID=us-east-2_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_ADMIN_API_URL=https://xxxxxxxxxx.execute-api.us-east-2.amazonaws.com
